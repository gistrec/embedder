# Адрес и порт (читает ecosystem.config.js). На сервере — IP в WireGuard-меше.
EMBEDDER_HOST=127.0.0.1
EMBEDDER_PORT=9110
# Bearer-токен клиентов. Пусто — без авторизации (только локально).
EMBEDDER_TOKEN=
# Модель fastembed; смена = переиндексация всех коллекций клиентов.
EMBEDDER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDER_CACHE_DIR=models
EMBEDDER_THREADS=2
# Лимит памяти процесса в pm2 (читает ecosystem.config.js): выше — перезапуск.
# 1500M хватает модели по умолчанию (~0,9 ГБ); для multilingual-e5-large нужно ~4G.
EMBEDDER_MAX_MEMORY=1500M
